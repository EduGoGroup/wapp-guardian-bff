# wapp-guardian-bff — variables de entorno (prefijo WAPP_). Copia a .env y ajusta. Sin secretos aquí.

# Ambiente lógico: "local" (permisivo, sin TLS) o cualquier otro (endurece Secure cookie + HSTS).
WAPP_GUARDIAN_ENV=local

# Dirección de escucha del BFF (host:port). Banda 81xx de wApp.
WAPP_GUARDIAN_HTTP_ADDR=:8104

# URL base de la API pública REST de la plataforma (:8103 /api/v1). Único interlocutor del BFF.
WAPP_PUBLIC_API_BASE=http://localhost:8103

# --- Cookie de sesión (JWT server-side, HttpOnly siempre) ---
# Secure: true en producción (TLS). En local false. Default: true salvo ENV=local.
WAPP_GUARDIAN_COOKIE_SECURE=false
# SameSite: lax | strict | none. "none" obliga Secure=true.
WAPP_GUARDIAN_COOKIE_SAMESITE=lax

# --- Consola del CLIENTE (Plan 047 · T2.1) ---
# Dirección de wapp-client-console, la aplicación a la que se mudó la administración de SESIONES
# (listar teléfonos, perfil activa|pasiva, enviar mensajes). La portada de este BFF la usa solo para
# ofrecer un enlace: no habla con ella.
# VACÍA es el caso normal, no una configuración a medias: en UAT las dos apps son loopback en puertos
# distintos y no hay URL pública. Sin valor, la portada dice dónde se administran y no pinta enlace.
WAPP_GUARDIAN_CLIENT_CONSOLE_URL=

# --- CORS (fail-closed) ---
# Allowlist CSV de orígenes completos (p. ej. https://consola.wapp.test). Vacío == same-origin. NUNCA "*".
WAPP_GUARDIAN_ALLOWED_ORIGINS=

# --- HSTS ---
# Emite Strict-Transport-Security (solo tras TLS). Default: sigue a COOKIE_SECURE.
WAPP_GUARDIAN_HSTS_ENABLED=false

# --- Rate-limit (en memoria, por IP/usuario) ---
WAPP_GUARDIAN_RATE_ENABLED=true
WAPP_GUARDIAN_RATE_RPS=5
WAPP_GUARDIAN_RATE_BURST=10

# --- Selector de "Usuario de prueba (Alpha)" en /login (solo UAT/dev) ---
# Pinta un combo en el login que autocompleta email+password de cuentas de prueba fijas en el HTML.
# Fail-closed por diseño: VACÍO O "false" == combo OFF (default). Alias legado: WAPP_ENABLE_ALPHA_LOGIN.
# ⚠️ Es un atajo deliberadamente inseguro (expone credenciales en el propio HTML). NUNCA en "true" en
# un ambiente con datos reales — solo en local o en UAT con datos sembrados de prueba.
WAPP_ALPHA_TEST_ACCOUNTS=false

# --- Modo dual de identidad (identity Plan 003 · T1.2) ---
# Endpoint JWKS de identity-api (:8200) con las claves públicas que verifican Identity Tokens.
# VACÍO O SIN DEFINIR == modo dual APAGADO: el BFF arranca sin identity, como hasta hoy (default).
# Con valor, el verificador se construye en el arranque y es fail-closed: si identity-api no responde,
# el BFF NO arranca. Ningún flujo lo usa todavía; lo estrena la Ola 3. http solo vale contra loopback.
# Dev: http://localhost:8200/.well-known/jwks.json
WAPP_IDENTITY_JWKS_URL=

# --- Delegación de la autenticación en identity (identity Plan 003 · T3.2/T3.4) ---
# URL base de identity-api (:8200), el único emisor de Identity Tokens del grupo.
# VACÍA O SIN DEFINIR == delegación APAGADA (default): login, refresh y logout siguen yendo a la API
# pública de wApp, exactamente como hasta hoy. Ni una llamada cambia.
# Con valor, el BFF autentica contra identity con el system "wapp.bff" y canjea el Identity Token por
# un Context Token de wApp (POST /api/v1/auth/exchange de la plataforma) en el mismo movimiento
# server-side. El Identity Token NO se persiste: la cookie custodia el Context Token y el refresh de
# identity. El logout revoca en identity SOLO esta sesión; la del Edge sobrevive (modelo Google).
# Requiere que la PLATAFORMA tenga su propio WAPP_IDENTITY_JWKS_URL puesto, o el canje responde 503.
# Dev: http://localhost:8200
WAPP_IDENTITY_URL=

# --- Timeouts del http.Server (segundos, anti-slowloris) ---
WAPP_GUARDIAN_READ_HEADER_TIMEOUT_SECS=5
WAPP_GUARDIAN_READ_TIMEOUT_SECS=15
WAPP_GUARDIAN_WRITE_TIMEOUT_SECS=30
WAPP_GUARDIAN_IDLE_TIMEOUT_SECS=60

# Acota, por petición entrante, TODA la cadena de llamadas a la API pública (incluida la secuencia
# refresco+reintento). DEBE quedar por debajo de WRITE_TIMEOUT_SECS para que el modo degradado alcance
# a pintarse. 0 o negativo lo desactiva.
WAPP_GUARDIAN_UPSTREAM_TIMEOUT_SECS=20
